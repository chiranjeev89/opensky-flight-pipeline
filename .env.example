# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# OpenSky: https://opensky-network.org -> Account -> API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Leave empty to use local Azurite. For real Azure, paste the storage
# account connection string (Portal -> Storage account -> Access keys).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=flight-lake

# Germany bounding box (keep in sync with dbt_project.yml vars)
BBOX_LAMIN=47.27
BBOX_LOMIN=5.87
BBOX_LAMAX=55.06
BBOX_LOMAX=15.04

AIRFLOW_UID=50000
AIRFLOW_JWT_SECRET=replace-with-a-long-random-string
